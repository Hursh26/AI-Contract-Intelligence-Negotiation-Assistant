# Copy this file to .env and fill in real values. .env is gitignored.

# --- App ---
PROJECT_NAME="AI Contract Intelligence & Negotiation Assistant"
API_V1_STR=/api/v1
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contract_assistant

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM integration (provider TBD) ---
LLM_API_KEY=
LLM_API_BASE_URL=

# --- File uploads ---
STORAGE_DIR=storage/contracts
MAX_UPLOAD_SIZE_MB=10

# --- CORS (comma-separated list in real .env; example below is a JSON array) ---
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
